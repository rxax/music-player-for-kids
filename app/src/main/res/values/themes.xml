<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MusicPlayerForKids" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="SoundButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.LessRounded</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/light_gray</item>
        <item name="strokeWidth">4dp</item>
        <item name="android:padding">8dp</item>
        <item name="iconSize">80dp</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@null</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="ShapeAppearance.LessRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
