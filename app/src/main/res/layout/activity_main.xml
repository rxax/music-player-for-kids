<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="#F8F9FA">

    <GridLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnCount="3"
        android:rowCount="3"
        android:useDefaultMargins="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1"
            android:text="@string/caption_1"
            app:icon="@drawable/ants"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            style="@style/SoundButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2"
            android:text="@string/caption_2"
            app:icon="@drawable/bingo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            style="@style/SoundButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3"
            android:text="@string/caption_3"
            app:icon="@drawable/star"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            style="@style/SoundButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4"
            android:text="@string/caption_4"
            app:icon="@drawable/if_youre_happy"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            style="@style/SoundButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5"
            android:text="@string/caption_5"
            app:icon="@drawable/jolly"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            style="@style/SoundButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn6"
            android:text="@string/caption_6"
            app:icon="@drawable/london"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            style="@style/SoundButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn7"
            android:text="@string/caption_7"
            app:icon="@drawable/mcdonald"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            style="@style/SoundButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn8"
            android:text="@string/caption_8"
            app:icon="@drawable/ducks"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            style="@style/SoundButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn9"
            android:text="@string/caption_9"
            app:icon="@drawable/star"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            style="@style/SoundButton"/>

    </GridLayout>

</LinearLayout>
